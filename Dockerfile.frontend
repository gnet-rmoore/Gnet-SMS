# Dockerfile.frontend — builds the React/Vite SPA from source and serves it with nginx.
#
# The SPA source lives at the repository root (index.html, vite.config.ts, src/).
# `npm run build` emits to dist/ (vite default). This replaces the old approach of
# repackaging the prebuilt snapshot in frontend/public/, which never got updated.
#
# Build context: repository root.

# --- Stage 1: Build the SPA ---
FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
# Skip scripts until sources are present (root `postinstall` runs prisma setup)
RUN npm ci --ignore-scripts

COPY . .
ENV NODE_ENV=production
ENV DATABASE_PROVIDER=postgresql
# Placeholder so `prisma generate` (called by `npm run build`) works without a live DB
ENV DATABASE_URL=postgresql://build:build@localhost:5432/placeholder?schema=public
RUN npm run build

# --- Stage 2: Runtime ---
FROM nginx:1.25.5-alpine

COPY 30-tune-worker-processes.sh /docker-entrypoint.d/30-tune-worker-processes.sh
RUN chmod +x /docker-entrypoint.d/30-tune-worker-processes.sh

COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /app/dist /usr/share/nginx/html

RUN addgroup -S appgroup && adduser -S appuser -G appgroup \
    && mkdir -p /var/cache/nginx /var/run \
    && chown -R appuser:appgroup /var/cache/nginx \
    && chown appuser:appgroup /var/run \
    && touch /var/run/nginx.pid \
    && chown appuser:appgroup /var/run/nginx.pid

USER appuser
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
