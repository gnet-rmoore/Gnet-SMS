# ---- images (fixes M2: never rely on the randalldocs2050 default) ----
DOCKERHUB_USER=gnetllc
DOCKER_TAG=latest

# ---- domain ----
APP_DOMAIN=sms.example.com            # your real domain
APP_URL=https://sms.example.com
S3_PUBLIC_URL=https://files.sms.example.com
ACME_EMAIL=ops@example.com            # Let's Encrypt expiry notices

# ---- generate each one:  openssl rand -hex 32 ----
JWT_ACCESS_SECRET=paste-random-64-hex
SUPER_ADMIN_JWT_SECRET=paste-random-64-hex
RECEIPT_HMAC_SECRET=paste-random-64-hex
INTERNAL_SERVICE_TOKEN=paste-random-64-hex   # ONE value for gateway + all services (H1)
MFA_ENCRYPTION_KEY=paste-base64-32-byte-key  # openssl rand -base64 32

# ---- MinIO root (MUST be set before the FIRST up: creds are stored on volume init) ----
MINIO_ROOT_USER=gnet
MINIO_ROOT_PASSWORD=paste-random-password    # >= 8 chars

# ---- identity / custom-domain edge (docs/CUSTOM_DOMAIN_EDGE.md is not in this package) ----
PLATFORM_EDGE_HOSTNAME=sms.example.com
PLATFORM_HOSTS=sms.example.com,www.sms.example.com
PLATFORM_CNAME_TARGET=3.147.239.14          # Lightsail public IP (us-east-2)

# ---- email (fixes M6; supported providers verified in image: smtp|sendgrid|resend|mailgun|ses) ----
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=paste-smtp-password
SMTP_SECURE=false
EMAIL_FROM=noreply@sms.example.com
REQUIRE_REGISTRATION_EMAIL_CONFIRM=true
REQUIRE_EMAIL_VERIFICATION=false
