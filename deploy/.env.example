# ---- images (fixes M2: never rely on the randalldocs2050 default) ----
DOCKERHUB_USER=gnetllc
DOCKER_TAG=latest

# ---- domain ----
APP_DOMAIN=gnetsms.com            # your real domain
APP_URL=https://gnetsms.com
S3_PUBLIC_URL=https://files.gnetsms.com
ACME_EMAIL=admin@gnetsms.com           # Let's Encrypt expiry notices

# ---- generate each one:  openssl rand -hex 32 ----
JWT_ACCESS_SECRET=ccd241ca6473c9903f9408c478aa6dcd1ac521c998bb26514e4f445830efcf7d
SUPER_ADMIN_JWT_SECRET=bdab9b106a5d35f5d2d76f775b9a5bedfa41d152e200466799567076c120222d
RECEIPT_HMAC_SECRET=7eea9fa0895a97a3ea389ea3775b2fc7a6544518315faf3313880540d84320f8
INTERNAL_SERVICE_TOKEN=1bdfd831bfa5b948129a57892d58032c98f6df32ea06d7d56b2acc79d7f98ffb  # ONE value for gateway + all services (H1)
MFA_ENCRYPTION_KEY=rltxmhnvCiqImjA2W9WYRgP+b8RnPXC3wHGPQ1DL+Qg=  # openssl rand -base64 32
# Separate key for encrypting stored SystemCredential secrets (falls back to
# MFA_ENCRYPTION_KEY when unset). REQUIRED in production.
CREDENTIAL_ENCRYPTION_KEY=rltxmhnvCiqImjA2W9WYRgP+b8RnPXC3wHGPQ1DL+Qg=  # openssl rand -base64 32

# ---- Super Admin database maintenance (Settings -> Database) ----
# Admin (cluster role `sms`) connection used ONLY for full-DB pg_dump + VACUUM
# (ANALYZE) across all schemas. Keep the app's per-schema DATABASE_URL separate.
DATABASE_MAINTENANCE_URL=postgresql://sms:sms@postgres:5432/sms_db
BACKUP_RETENTION=7
# Bucket for off-box backup copies (point S3_ENDPOINT at external S3 for DR).
S3_BACKUP_BUCKET=sms-backups

# ---- platform Super Admin seed (identity) ----
# Runs automatically on every boot and is idempotent: it creates the Super Admin
# only if none exists (checks role SUPER_ADMIN), then skips — no reset, no
# duplicates. Set these to control the first account. Set RUN_SEED=false to disable.
RUN_SEED=true
SUPER_ADMIN_EMAIL=admin@gnetsms.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

# ---- MinIO root (MUST be set before the FIRST up: creds are stored on volume init) ----
MINIO_ROOT_USER=gnet
MINIO_ROOT_PASSWORD=15hdkspVy5D2LqC_zrKe4t4dP-fsUa0Oiz73QuIl   # >= 8 chars

# ---- identity / custom-domain edge (docs/CUSTOM_DOMAIN_EDGE.md is not in this package) ----
PLATFORM_EDGE_HOSTNAME=gnetsms.com
PLATFORM_HOSTS=gnetsms.com,www.gnetsms.com
PLATFORM_CNAME_TARGET=3.147.239.14          # Lightsail public IP (us-east-2)

# ---- email (fixes M6; supported providers verified in image: smtp|sendgrid|resend|mailgun|ses) ----
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=paste-smtp-password
SMTP_SECURE=false
EMAIL_FROM=noreply@sms.example.com
REQUIRE_REGISTRATION_EMAIL_CONFIRM=true
REQUIRE_EMAIL_VERIFICATION=false
