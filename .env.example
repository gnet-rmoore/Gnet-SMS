# School Management System — environment template
# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development

# Public app URL (used for CORS / Socket.io allowlist). Comma-separate for multiple.
APP_URL=http://localhost:3000,http://localhost:8080,http://localhost:8081

# Database — PostgreSQL only (SQLite is not supported)
# One Postgres cluster; schemas + per-service roles (Phase A). Prefer managed HA
# in production — do not stand up eight separate databases by default.
# Admin / monolith tooling:
DATABASE_URL="postgresql://sms:sms@localhost:5432/sms_db?schema=public"
# Domain services (compose defaults): postgresql://sms_<schema>:sms_<schema>@localhost:5432/sms_db?schema=<schema>
# e.g. identity → postgresql://sms_identity:sms_identity@localhost:5432/sms_db?schema=identity
DATABASE_PROVIDER=postgresql

# JWT — required in production; use long random strings and different values
JWT_ACCESS_SECRET=change-me-access-secret
SUPER_ADMIN_JWT_SECRET=change-me-super-admin-secret

# Platform Super Admin (Identity). The seed runs automatically on every boot and
# is idempotent: it creates the Super Admin only if none exists, then skips. Set
# SUPER_ADMIN_EMAIL / SUPER_ADMIN_PASSWORD here to control the first account
# (defaults: superadmin@yoursms.com / admin123 — override in prod). Set
# RUN_SEED=false only if you want to disable seeding entirely.
RUN_SEED=true
SUPER_ADMIN_EMAIL=superadmin@yoursms.com
# SUPER_ADMIN_PASSWORD=set-a-strong-password
# AES-256 key for TOTP secrets at rest (base64, 32+ bytes). Required in production when MFA is used.
MFA_ENCRYPTION_KEY=
# AES-256 key for stored SystemCredential secrets (base64). Falls back to
# MFA_ENCRYPTION_KEY when unset; REQUIRED in production.
# CREDENTIAL_ENCRYPTION_KEY=
# SMS OTP provider for school MFA: console (logs + email fallback), twilio (future)
SMS_PROVIDER=console

# Super Admin database maintenance (Settings → Database). Admin (cluster role
# `sms`) URL used ONLY for full-DB pg_dump + VACUUM (ANALYZE) across schemas.
# DATABASE_MAINTENANCE_URL=postgresql://sms:sms@localhost:5432/sms_db
# BACKUP_RETENTION=7
# S3_BACKUP_BUCKET=sms-backups

# MinIO / S3 (staff photos, admissions backgrounds, classroom assets)
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_URL=http://localhost:9000
# Browser upload CORS; presigned URLs still require their signature.
# MINIO_API_CORS_ALLOW_ORIGIN=*
# MINIO_ROOT_USER=smsminio
# MINIO_ROOT_PASSWORD=smsminio-secret

# Shared secret for service-to-service calls (x-internal-token). Must match on
# Identity, Classroom, Academic, Lifecycle, Staff, Finance, Comms, etc.
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# Redis — event bus / BullMQ / Socket.IO adapter (docker-compose exposes 6379)
REDIS_URL=redis://localhost:6379

# Optional
PORT=3000
# CORS_ORIGIN=http://localhost:3000

# Optional service identity for structured logs
# SERVICE_NAME=sms-api

# Transactional email (Identity service)
# EMAIL_PROVIDER=console|smtp|sendgrid|ses|mailgun|resend
# EMAIL_FROM=noreply@yourdomain.com
# REQUIRE_EMAIL_VERIFICATION=false
# REQUIRE_REGISTRATION_EMAIL_CONFIRM=true

# SMTP (also works with many relays)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# SendGrid
# SENDGRID_API_KEY=

# AWS SES (email — separate from S3 below)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Mailgun
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.yourdomain.com
# MAILGUN_REGION=us

# Resend
# RESEND_API_KEY=

# Public CAPTCHA (Cloudflare Turnstile) — optional in dev; required when CAPTCHA_SECRET is set
# CAPTCHA_SECRET=
# VITE_TURNSTILE_SITE_KEY=

# Admission document virus scan (optional ClamAV REST adapter)
# CLAMAV_URL=http://clamav:8080
# VIRUS_SCAN_FAIL_OPEN=true
# VIRUS_SCAN_FORCE_INFECTED=false

# Online exam integrity email to school staff (optional)
# ONLINE_EXAM_PROCTOR_EMAIL=1

# ---- Online exam + live proctoring scale tuning (Academic) ----
# All optional; values shown are the code defaults except where noted.
# EXAM_RATE_LIMIT_ENABLED=true          # throttle per-attempt answer/violation/heartbeat/submit (default: off)
# EXAM_SWEEP_BATCH_SIZE=500             # expired attempts finalized per sweep tick
# EXAM_SWEEP_CONCURRENCY=5              # parallel finalize workers per tick
# EXAM_SWEEP_INTERVAL_MS=30000          # sweep cadence (ms)
# EXAM_FRAME_PURGE_BATCH_SIZE=2000      # proctor frames purged per tick
# EXAM_FRAME_PURGE_CONCURRENCY=20       # parallel S3 frame deletes per tick
# EXAM_IDENTITY_BATCH_ENABLED=true      # batch identity lookups for the live proctor view (default: off)
# EXAM_IDENTITY_CACHE_TTL_MS=60000      # identity lookup cache TTL (ms)
# EXAM_FRAME_FANOUT_RESTRICTED=true     # keep screen.frame out of the whole-exam room (default: on)
# DB_SYNC_STRATEGY=push                 # "migrate" to run prisma migrate deploy instead of db push
# Client build-time toggle (Vite):
# VITE_EXAM_SEND_DELTAS_ENABLED=true    # send only changed answers per flush (default: on)

# AWS S3 (receipts / files — separate from SES)
# AWS_S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
