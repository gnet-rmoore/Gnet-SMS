    "start": "vite preview --host 0.0.0.0 --port 8080",
    "db:migrate:prod": "tsx prisma/setup-provider.ts && prisma migrate deploy",
    "db:push": "tsx prisma/setup-provider.ts && prisma db push",
    "db:seed": "tsx prisma/seed.ts"
