// Operations schema (Phase 3-5 extraction)
// Target Postgres schema: `ops` (see MICROSERVICES_ROADMAP.md §4 Phase A)
//
// Owns: Vehicle, VehicleMaintenance, WorkOrder, InventoryItem, SecurityLog, Requisition.
// schoolId / driverId / requestedBy / assignedTo / loggedBy are plain UUID
// strings — no Prisma relation to Identity.School / Identity.User.

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["ops"]
}

model Vehicle {
  id              String               @id @default(uuid())
  plateNumber     String               @unique
  model           String
  capacity        Int
  status          String               @default("ACTIVE")
  driverId        String? // Identity.User.id (no FK)
  schoolId        String // Identity.School.id (no FK)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  maintenanceLogs VehicleMaintenance[]

  @@index([schoolId])
  @@schema("ops")
}

model VehicleMaintenance {
  id          String    @id @default(uuid())
  vehicleId   String
  description String
  cost        Float     @default(0)
  date        DateTime  @default(now())
  nextService DateTime?
  createdAt   DateTime  @default(now())
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@schema("ops")
}

model TransportRoute {
  id            String            @id @default(uuid())
  schoolId      String
  name          String
  vehicleId     String?
  driverStaffId String?
  status        String            @default("ACTIVE")
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  stops         TransportStop[]
  riders        TransportRider[]

  @@index([schoolId])
  @@schema("ops")
}

model TransportStop {
  id         String         @id @default(uuid())
  routeId    String
  name       String
  sortOrder  Int            @default(0)
  pickupTime String?
  createdAt  DateTime       @default(now())
  route      TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  riders     TransportRider[]

  @@index([routeId])
  @@schema("ops")
}

model TransportRider {
  id        String         @id @default(uuid())
  routeId   String
  studentId String
  stopId    String?
  status    String         @default("ACTIVE")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  route     TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop      TransportStop? @relation(fields: [stopId], references: [id], onDelete: SetNull)

  @@unique([routeId, studentId])
  @@index([routeId])
  @@index([studentId])
  @@schema("ops")
}

model WorkOrder {
  id          String   @id @default(uuid())
  title       String
  description String
  requestType     String           @default("REPAIR")
  priority    String   @default("MEDIUM")
  impact          String           @default("MEDIUM")
  status      String   @default("OPEN")
  location    String?
  building        String?
  room            String?
  dueAt           DateTime?
  safetyRelated   Boolean          @default(false)
  safetyNotes     String?
  accessNotes     String?
  estimatedCost   Float?
  resolutionNotes String?
  completedAt     DateTime?
  inventoryItemId String?
  assignedTo  String? // Identity.User.id (no FK)
  requestedBy String // Identity.User.id (no FK)
  schoolId    String // Identity.School.id (no FK)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  asset           InventoryItem?   @relation("WorkOrderAsset", fields: [inventoryItemId], references: [id], onDelete: SetNull)
  events          WorkOrderEvent[]

  @@index([schoolId])
  @@index([schoolId, status, createdAt])
  @@index([schoolId, dueAt])
  @@index([inventoryItemId])
  @@schema("ops")
}

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  itemType          String              @default("CONSUMABLE")
  sku               String?
  description       String?
  category    String
  quantity    Int      @default(0)
  unit        String   @default("pcs")
  minQuantity Int      @default(5)
  location          String?
  supplier          String?
  unitCost          Float?
  manufacturer      String?
  model             String?
  serialNumber      String?
  assetTag          String?
  condition         String?
  assetStatus       String?
  assignedTo        String? // Identity.User.id (no FK)
  purchaseDate      DateTime?
  warrantyExpiresAt DateTime?
  notes             String?
  schoolId    String // Identity.School.id (no FK)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  movements         InventoryMovement[]
  workOrders        WorkOrder[]         @relation("WorkOrderAsset")

  @@unique([schoolId, sku])
  @@unique([schoolId, serialNumber])
  @@unique([schoolId, assetTag])
  @@index([schoolId])
  @@index([schoolId, itemType, category])
  @@index([schoolId, quantity, minQuantity])
  @@schema("ops")
}

model InventoryMovement {
  id                  String        @id @default(uuid())
  itemId              String
  baselineItemId      String?       @unique
  schoolId            String
  movementType        String
  quantityDelta       Int           @default(0)
  quantityBefore      Int
  quantityAfter       Int
  reason              String
  reference           String?
  previousCondition   String?
  newCondition        String?
  previousAssetStatus String?
  newAssetStatus      String?
  previousAssignedTo  String?
  newAssignedTo       String?
  movementUnitCost    Float?
  details             Json?
  performedBy         String // Identity.User.id (no FK)
  createdAt           DateTime      @default(now())
  item                InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([schoolId, itemId, createdAt])
  @@index([schoolId, movementType, createdAt])
  @@schema("ops")
}

model WorkOrderEvent {
  id                  String    @id @default(uuid())
  workOrderId         String
  baselineWorkOrderId String?   @unique
  actorId             String // Identity.User.id (no FK)
  eventType           String
  summary             String
  oldValue            String?
  newValue            String?
  createdAt           DateTime  @default(now())
  workOrder           WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId, createdAt])
  @@schema("ops")
}

model SecurityLog {
  id          String   @id @default(uuid())
  type        String
  description String
  location    String?
  severity    String   @default("LOW")
  loggedBy    String // Identity.User.id (no FK)
  schoolId    String // Identity.School.id (no FK)
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@schema("ops")
}

model Requisition {
  id          String   @id @default(uuid())
  title       String
  description String?
  amount      Float
  status      String   @default("PENDING")
  requestedBy String // Identity.User.id (no FK)
  schoolId    String // Identity.School.id (no FK)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([schoolId])
  @@schema("ops")
}
